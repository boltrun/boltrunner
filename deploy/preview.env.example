# Copy outside the repository, e.g. ~/.config/boltrunner/preview.env (chmod 600).
# Required: VPS IP used in preview links; it is not detected automatically.
PREVIEW_IP=
PREVIEW_LISTEN=:8080
PREVIEW_MAIN_PORT=20000
PREVIEW_PORTS=20001-20100
PREVIEW_REPOSITORY=boltrun/boltrunner
# Generate with: openssl rand -hex 32
PREVIEW_TOKEN=replace-with-a-random-token-of-at-least-32-characters
PREVIEW_MAX=5
# Optional for public repositories; required for private repos. Read-only
# fine-grained token with Pull requests: Read and Contents: Read for this repo.
# PREVIEW_GITHUB_TOKEN=
