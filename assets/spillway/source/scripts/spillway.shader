textures/skies/spillway
{
 surfaceparm sky
 surfaceparm nolightmap
 surfaceparm noimpact
 skyparms env/spillway/day - -
 q3map_sunExt 1 0.92 0.79 165 315 58 3 16
 q3map_skylight 55 4
}
textures/spillway/concrete
{
 qer_editorimage textures/spillway/concrete.png
 {
 map $lightmap
 rgbGen identity
 }
 {
 map textures/spillway/concrete.png
 blendFunc filter
 rgbGen identity
 }
}
